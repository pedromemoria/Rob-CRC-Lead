PORT=3000
HOST=0.0.0.0
# Supabase Connect → Session pooler (5432). A aplicação ativa TLS.
DATABASE_URL=
# Opcional. CA PEM do banco caso a cadeia não seja confiável pelo Node.js.
DATABASE_SSL_CA=
# Gere ADMIN_TOKEN com openssl rand -hex 32
ADMIN_TOKEN=
# Opcionais. Configure juntos. Senha de 8 a 1024 caracteres.
# Sem o par, entre com admin@robocrc.local e o ADMIN_TOKEN atual.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Gemini é o provedor principal. Configure pelo menos uma chave de IA.
GEMINI_API_KEY=
# Opcional. Padrão: gemini-3.6-flash. A aplicação tenta outros modelos em caso de 404 ou 429.
GEMINI_MODEL=
# Contingência opcional.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Opcional. Chave dedicada com 64 caracteres hexadecimais. Defina antes de cadastrar clínicas.
CRM_ENCRYPTION_KEY=
GHL_API_VERSION=v3
# Opcional. Chave pública Ed25519 SPKI DER em Base64. Vazio usa a chave oficial.
GHL_WEBHOOK_PUBLIC_KEY=
